# Backend API URL
VITE_API_URL=https://aimobil.onrender.com

# Server Configuration
PORT=10000
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=SEU_TELEGRAM_BOT_TOKEN_AQUI

# AI APIs
GEMINI_API_KEY=SEU_GEMINI_API_KEY_AQUI
GROQ_API_KEY=SEU_GROQ_API_KEY_AQUI

# CORS Origins (separado por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# TURSO Database Configuration
TURSO_DATABASE_URL=SEU_TURSO_DATABASE_URL_AQUI
TURSO_AUTH_TOKEN=SEU_TURSO_AUTH_TOKEN_AQUI

